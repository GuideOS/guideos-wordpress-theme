{
	"settings": {
		"color": {
			"palette": [
				{
					"color": "#1f6feb",
					"name": "Blau",
					"slug": "custom-blau"
				},
				{
					"color": "#ffffff",
					"name": "Weiss",
					"slug": "custom-weiss"
				},
				{
					"color": "#2b3542",
					"name": "Grau",
					"slug": "custom-grau"
				},
				{
					"color": "#000",
					"name": "Schwarz",
					"slug": "custom-schwarz"
				},
				{
					"color": "#3fb950",
					"name": "Gruen",
					"slug": "custom-gruen"
				},
				{
					"color": "#56d4dd",
					"name": "Cyan",
					"slug": "custom-cyan"
				},
				{
					"color": "#161d27",
					"name": "Flaeche",
					"slug": "custom-flaeche"
				},
				{
					"color": "#0d1117",
					"name": "Hintergrund",
					"slug": "custom-hintergrund"
				}
			]
		},
		"layout": {
			"contentSize": "780px",
			"wideSize": "1280px"
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFace": [
						{
							"fontFamily": "Vollkorn",
							"fontStyle": "italic",
							"fontWeight": "400 900",
							"src": [
								"file:./assets/fonts/vollkorn/Vollkorn-Italic-VariableFont_wght.woff2"
							]
						},
						{
							"fontFamily": "Vollkorn",
							"fontStyle": "normal",
							"fontWeight": "400 900",
							"src": [
								"file:./assets/fonts/vollkorn/Vollkorn-VariableFont_wght.woff2"
							]
						}
					],
					"fontFamily": "Vollkorn, serif",
					"name": "Vollkorn",
					"slug": "vollkorn"
				},
				{
					"fontFace": [
						{
							"fontFamily": "\"Fira Code\"",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"src": [
								"file:./assets/fonts/fira-code/FiraCode-VariableFont_wght.woff2"
							]
						}
					],
					"fontFamily": "\"Fira Code\", monospace",
					"name": "Fira Code",
					"slug": "fira-code"
				}
			]
		}
	},
	"styles": {
		"blocks": {
			"core/post-author-name": {
				"typography": {
					"fontWeight": "300"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontWeight": "300"
				}
			},
			"core/post-title": {
				"typography": {
					"fontWeight": "600",
					"letterSpacing": "-0.02em"
				}
			},
			"core/pullquote": {
				"elements": {
					"cite": {
						"typography": {
							"fontFamily": "var(--wp--preset--font-family--fira-code)",
							"fontWeight": "300",
							"letterSpacing": "-0.14px"
						}
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fira-code)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "400"
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fira-code)",
					"fontWeight": "500",
					"letterSpacing": "-0.18px"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fira-code)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "600"
				}
			}
		},
		"color": {
			"background": "var(--gos-bg)",
			"text": "var(--gos-text)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--custom-blau)",
					"text": "var(--wp--preset--color--custom-weiss)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fira-code)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "500",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem)",
					"letterSpacing": "-0.03em",
					"lineHeight": "1.1"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "clamp(1.75rem, 1.4rem + 1.6vw, 2.5rem)",
					"letterSpacing": "-0.025em",
					"lineHeight": "1.18"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "clamp(1.375rem, 1.2rem + 0.9vw, 1.875rem)",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.25"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem)",
					"letterSpacing": "-0.015em",
					"lineHeight": "1.3"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "1.125rem",
					"letterSpacing": "-0.01em",
					"lineHeight": "1.35"
				}
			},
			"heading": {
				"color": {
					"text": "var(--gos-heading)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fira-code)",
					"fontWeight": "600"
				}
			},
			"link": {
				"color": {
					"text": "var(--gos-accent-hover)"
				}
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--fira-code)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"letterSpacing": "-0.01em",
			"lineHeight": "1.6"
		}
	},
	"version": 3,
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json"
}
